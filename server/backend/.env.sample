# server/backend/.env.sample — variable SHAPE only (no real values).
# Copy to server/backend/.env and fill in. .env is gitignored — never commit real secrets.

# ── Django core ──────────────────────────────────────────────
DJANGO_SECRET_KEY=replace_me_generate_with_get_random_secret_key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
CORS_ALLOWED_ORIGINS=

# ── Database (Postgres; omit to fall back to local sqlite) ───
# Current: Neon. Target: Cloud SQL (Phase 4).
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ── Object storage: Google Cloud Storage (all media) ─────────
GCS_PROJECT_ID=eleganza-ar
GCS_BUCKET_NAME=eleganza-ar-media-project-number
# Local dev only: path to the bucket-scoped service-account JSON key (outside the repo).
# On Cloud Run this is unset; the attached service account / ADC provides credentials.
GOOGLE_APPLICATION_CREDENTIALS=/path/to/eleganza-ar/storage-signer.json

# ── Google OAuth ─────────────────────────────────────────────
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# ── Email ────────────────────────────────────────────────────
# SendGrid trial expired — being replaced. Default backend is console.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=no-reply@example.com
# Legacy (SendGrid, retired):
# SENDGRID_API_KEY=
# SMTP option (e.g. Gmail App Password) — pending decision:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=

# ── Frontend / misc ──────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
REACT_APP_API_BASE_URL=http://127.0.0.1:8000/api

# ── Deploy tuning (Cloud Run) ────────────────────────────────
# PORT=8000
# GUNICORN_WORKERS=2
# GUNICORN_THREADS=4
# GUNICORN_TIMEOUT=120
# RUN_MIGRATIONS=0
# RUN_COLLECTSTATIC=0
